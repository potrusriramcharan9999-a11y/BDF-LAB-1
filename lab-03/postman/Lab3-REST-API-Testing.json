    {
      "name": "3. Search using search_q",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/books?search_q=Java",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "search_q",
              "value": "Java"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Books match search query Java\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.data.forEach(function(book) {",
              "        pm.expect(book.title.toLowerCase()).to.include(\"java\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Sort ASC",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/books?order_by=price&order=ASC",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "ASC"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Prices are in ascending order\", function () {",
              "    var jsonData = pm.response.json();",
              "    for (var i = 1; i < jsonData.data.length; i++) {",
              "        pm.expect(jsonData.data[i].price).to.be.at.least(jsonData.data[i - 1].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
